# Copy these values into the Dokploy compose service's env field. NEVER commit real values.

# 48-char hex — generate: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# 64-char hex — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=

# OpenRouter key (covers all LLM features + embeddings)
OPENROUTER_API_KEY=
